{
  "manifest_version": 3,
  "name": "Note Excluder",
  "version": "0.5.0",
  "description": "note.com 上で有料記事、除外ユーザー、NGワードを含む記事を非表示にします",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://note.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["excludes.txt", "allow_paid_users.txt", "allow_urls.txt", "ng_words.txt"],
      "matches": ["https://note.com/*"]
    }
  ]
}
